# SusOrBus Configuration

# Server configuration
PORT=3000
HOST=127.0.0.1

# Headless Browser Worker Configuration (Optional)
# If left blank, SusOrBus runs in static scanning mode and accurately reports
# browser behavior analysis as 'unavailable'.
BROWSER_WORKER_URL=
BROWSER_WORKER_SECRET=

# Allowed CORS Origins (comma-separated if expanded)
ALLOWED_ORIGIN=https://tejusbhasin.github.io

